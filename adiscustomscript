local function updateDropScrollLayout()
    local desiredHeight = math.min(#partsList * 30 + 8, 160)
    local containerPos = tabContainer.AbsolutePosition
    local containerSize = tabContainer.AbsoluteSize
    local dmPos = dropMain.AbsolutePosition
    local dmSize = dropMain.AbsoluteSize
    local belowSpace = (containerPos.Y + containerSize.Y) - (dmPos.Y + dmSize.Y) - 10
    local aboveSpace = dmPos.Y - containerPos.Y - 10

    desiredHeight = math.min(desiredHeight, containerSize.Y - 20)
    local menuWidth = math.min(170, containerSize.X - 30)
    local relativeX = dmPos.X - containerPos.X
    local x = math.clamp(relativeX, 10, math.max(10, containerSize.X - menuWidth - 10))

    if belowSpace >= 40 then
        local h = math.min(desiredHeight, math.max(40, belowSpace))
        dropScroll.AnchorPoint = Vector2.new(0, 0)
        dropScroll.Size = UDim2.new(0, menuWidth, 0, h)
        local y = dmPos.Y - containerPos.Y + dmSize.Y + 6
        dropScroll.Position = UDim2.new(0, x, 0, y)
    else
        local h = math.min(desiredHeight, math.max(40, aboveSpace))
        dropScroll.AnchorPoint = Vector2.new(0, 1)
        dropScroll.Size = UDim2.new(0, menuWidth, 0, h)
        local y = dmPos.Y - containerPos.Y - 6
        dropScroll.Position = UDim2.new(0, x, 0, y)
    end

    dropScroll.CanvasSize = UDim2.new(0, 0, 0, (#partsList * 30) + 8)
end

