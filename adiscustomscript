-- Camera lock: keep camera aimed at locked player's target while allowing normal mouse movement
local lastMouseDelta = Vector2.new(0, 0)
local mouseMoveCooldown = 0

game:GetService('RunService').RenderStepped:Connect(function()
    if _G.CamLock_Enabled then
        local mouseDelta = UIS:GetMouseDelta()
        lastMouseDelta = mouseDelta
        mouseMoveCooldown = math.max(0, mouseMoveCooldown - 1)

        if mouseDelta.Magnitude > 0.01 then
            mouseMoveCooldown = 8
            lastCamLockDir = cam.CFrame.LookVector
            if lockedLabel then
                lockedLabel.Text = 'Locked: ' .. (lastLockedPlayer and (lastLockedPlayer.DisplayName or lastLockedPlayer.Name) or 'None')
            end
            return
        end

        if mouseMoveCooldown > 0 then
            if lockedLabel then
                lockedLabel.Text = 'Locked: ' .. (lastLockedPlayer and (lastLockedPlayer.DisplayName or lastLockedPlayer.Name) or 'None')
            end
            return
        end

        if lastLockedPlayer and currentCamLockTargetPart then
            local humanoid = lastLockedPlayer.Character and lastLockedPlayer.Character:FindFirstChild('Humanoid')
            if humanoid and humanoid.Health > 0 and currentCamLockTargetPart and currentCamLockTargetPart.Parent then
                local targetDir = (currentCamLockTargetPart.Position - cam.CFrame.Position)
                if targetDir.Magnitude > 0 then
                    targetDir = targetDir.Unit
                    local smoothness = math.clamp(_G.CamLock_Smoothness or 0.2, 0.1, 1)
                    local t = (smoothness - 0.1) / 0.9
                    local alpha = 0.01 + 0.99 * (t * t * t)
                    if not lastCamLockDir then
                        lastCamLockDir = cam.CFrame.LookVector
                    end
                    local blended = (lastCamLockDir * (1 - alpha) + targetDir * alpha)
                    if blended.Magnitude > 0 then
                        lastCamLockDir = blended.Unit
                        cam.CFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + lastCamLockDir)
                    end
                    if lockedLabel then
                        lockedLabel.Text = 'Locked: ' .. (lastLockedPlayer.DisplayName or lastLockedPlayer.Name)
                    end
                    return
                end
            end
        end

        if lockedLabel then
            lockedLabel.Text = 'Locked: ' .. (lastLockedPlayer and (lastLockedPlayer.DisplayName or lastLockedPlayer.Name) or 'None')
        end
        return
    end

    if lockedLabel then
        lockedLabel.Text = 'Locked: None'
    end
end)

