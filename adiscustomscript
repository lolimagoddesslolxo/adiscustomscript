local lastLockedPlayer = nil
local lastCamLockDir = nil
local currentCamLockTargetPart = nil

local function getLockPart(character)
    return getTargetPart(character) or character:FindFirstChild('Head')
end

local function getCamLockTargetForCursor()
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    local bestPlayer, bestPart = nil, nil
    local bestDist = math.huge

    for _, p in pairs(plrs:GetPlayers()) do
        if p ~= me and not isWhitelisted(p) then
            local character = p.Character
            local humanoid = character and character:FindFirstChild('Humanoid')
            if character and humanoid and humanoid.Health > 0 then
                local part = getLockPart(character)
                if part and part:IsA('BasePart') then
                    local screenPos, onScreen = cam:WorldToScreenPoint(part.Position)
                    if onScreen then
                        local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                        local dist = (screenVec - mousePos).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestPlayer = p
                            bestPart = part
                        end
                    end
                end
            end
        end
    end

    return bestPlayer, bestPart
end

local function updateCamLockState(enabled)
    _G.CamLock_Enabled = enabled
    camLockToggleBtn.Text = _G.CamLock_Enabled and 'ON' or 'OFF'
    camLockToggleBtn.BackgroundColor3 = _G.CamLock_Enabled and Color3.fromRGB(170, 130, 255) or Color3.fromRGB(245, 240, 250)
    if _G.CamLock_Enabled then
        local targetPlayer, targetPart = getCamLockTargetForCursor()
        lastLockedPlayer = targetPlayer
        currentCamLockTargetPart = targetPart
        if targetPlayer and targetPart and me.Character and me.Character:FindFirstChild('HumanoidRootPart') then
            local rootPos = me.Character.HumanoidRootPart.Position
            local direction = targetPart.Position - rootPos
            lastCamLockDir = direction.Magnitude > 0 and direction.Unit or cam.CFrame.LookVector
            lockedLabel.Text = 'Locked: ' .. (targetPlayer.DisplayName or targetPlayer.Name)
        else
            lastCamLockDir = nil
            lockedLabel.Text = 'Locked: None'
        end
    else
        lastLockedPlayer = nil
        currentCamLockTargetPart = nil
        lastCamLockDir = nil
        lockedLabel.Text = 'Locked: None'
    end
end

