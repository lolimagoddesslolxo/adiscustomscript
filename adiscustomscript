local function applyHeadlessState(character)
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end

    local enabled = _G.Headless_Enabled
    head.Transparency = enabled and 1 or 0
    head.LocalTransparencyModifier = enabled and 1 or 0

    if enabled then
        head.Material = Enum.Material.ForceField
    else
        head.Material = Enum.Material.SmoothPlastic
    end
end

me.CharacterAdded:Connect(function(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    task.defer(function()
        task.wait(0.1)
        applyHeadlessState(character)
    end)
end)

